  "slots": {
    "settings": { "id": "apik-switch", "label": "API Key 管理", "order": 12 },
    "composer": { "id": "apik-composer-switch", "order": 100 },
    "runCard": "tool.view.cordis",
    "toast": { "slot": "shell.overlay", "id": "apik-toast", "order": 100 }
